# LINGORA BACKEND CONFIGURATION
# ASP.NET Core & Supabase PostgreSQL Connection

ConnectionStrings__SupabasePostgres=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project-ref;Password=your-strong-password;SSL Mode=Require;Trust Server Certificate=true

JwtSettings__SecretKey=LingoraEnterpriseSecretKeyForAuthentication2026!MustBe32BytesOrMore
JwtSettings__Issuer=LingoraAPI
JwtSettings__Audience=LingoraClients
JwtSettings__ExpiryHours=24

# Google Gemini API Key
Gemini__ApiKey=AIzaSyYourActualGoogleGeminiApiKeyHere
Gemini__ModelName=gemini-1.5-pro
